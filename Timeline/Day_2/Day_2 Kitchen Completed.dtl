if {KitchenController.recipeQuality} >= 50 and {KitchenController.recipeQuality} <= 100:
	[voice path="res://Assets/Audio/VA/Elise/Thanks Dad.mp3" volume="-3.0" bus="Character Voice"]
	Elise: Thanks dad.
else:
	[voice path="res://Assets/Audio/VA/Elise/I Think I’ll just go to Bed Early.mp3" volume="-7.0" bus="Character Voice"]
	Elise: I think I'll just go to bed early.