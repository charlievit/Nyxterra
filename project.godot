; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Solais"
run/main_scene="uid://bf5g134nk8ebe"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://Assets/Images/icon.svg"
config/windows_native_icon="res://Assets/Images/Build Resources/SolaisIcon.ico"

[autoload]

TaskManager="*res://Scenes/UI/task_menu.tscn"
KitchenController="*res://Scripts/CookingMinigame/kitchen_puzzle.gd"
GameManager="*res://Scripts/Main/GameManager.gd"
SaveManager="*res://Scripts/save_load/save_manager.gd"
SceneLoader="*res://Scripts/scene_loader.gd"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"

[dialogic]

directories/dch_directory={
"Elise": "res://Timeline/Elise.dch",
"Elises Dialogue": "res://Timeline/Elises Dialogue.dch",
"Narrator": "res://Timeline/Narrator.dch",
"Scottish Fisherman": "res://Timeline/Scottish Fisherman.dch",
"Smith": "res://Timeline/Smith.dch",
"Suspicious voice": "res://Timeline/Suspicious voice.dch",
"Sutherland": "res://Timeline/Sutherland.dch"
}
directories/dtl_directory={
"Elises Dialogue": "res://Timeline/Elises Dialogue.dtl",
"Intro": "res://Timeline/Intro.dtl"
}
layout/style_directory={}
glossary/default_case_sensitive=true
layout/style_list=[]
layout/default_style="Default"
variables={}
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
history/simple_history_save=false
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}

[display]

window/subwindows/embed_subwindows=false
window/stretch/mode="viewport"
window/main_scene="uid://bf5g134nk8ebe"
window/canvas_textures/default_texture_filter=1
window/movie_file="C:/Users/Jordon/Nyxterra/DEBUG_VIDS/gearBoxPuzzleFinal.avi"

[editor]

movie_writer/movie_file="C:/Users/Jordon/Nyxterra/DEMO_DEBUG_VIDS/footSteps.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

[global_group]

Gears="The gears used in the Gearbox Puzzle."
"Gear Buttons"="Buttons used in the Gearbox Puzzle."
ingredients="Kichen Puzzle Group for Ingredients"
pot="pot for the Kitchen Minigame"
player="The player."

